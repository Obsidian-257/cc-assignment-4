
# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_URL=https://YOUR_STORAGE_ACCOUNT.blob.core.windows.net
AZURE_BLOB_CONTAINER=documents

# Azure Queue Storage
AZURE_QUEUE_ACCOUNT_URL=https://YOUR_STORAGE_ACCOUNT.queue.core.windows.net
AZURE_QUEUE_NAME=document-jobs
AZURE_FAILED_QUEUE_NAME=failed-documents

# Azure Cosmos DB for NoSQL
COSMOS_ENDPOINT=https://YOUR_COSMOS_ACCOUNT.documents.azure.com:443/
COSMOS_DATABASE=document-pipeline
COSMOS_CONTAINER=documents

# Azure AI Foundry / Azure OpenAI
# Use the resource endpoint with /openai/v1/ at the end.
AI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/openai/v1/
AI_MODEL=gpt-4.1-mini